; UMBRAL — proyecto personal Godot 4.5+
config_version=5

[application]
config/name="UMBRAL — Protocolo Cero"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Supervivencia FPS de horror. Proyecto personal no comercial. Recursos de terceros: docs/THIRD_PARTY_NOTICES.md."
config/icon="res://assets/fx/circle_05.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.018, 0.026, 0.03, 1)
lights_and_shadows/directional_shadow/size=2048

[audio]
default_bus_layout=""

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[layer_names]
3d_physics/layer_1="Mundo"
3d_physics/layer_2="Enemigos"
3d_physics/layer_3="Jugador"
3d_physics/layer_4="Restos"
